function initGame() {
let finalPath = [];
let poolCopy = [...scenarioPool];
for(let loop = 0; loop < 15; loop++) {
let baseElement = poolCopy[loop % poolCopy.length];
finalPath.push({ type: "base", data: baseElement });
finalPath.push({ type: "followup", key: baseElement.choices });
}
gameState.selectedScenarios = finalPath;
renderSetup();
}
function renderSetup() {
document.getElementById("interactive-container").innerHTML =  <div class="form-group"><label>Enter Name:</label><input type="text" id="input-name" class="input-field" value="Alex"></div> <div class="form-group"><label>Choose College:</label><select id="select-college" class="select-field"><option value="State University">State University</option><option value="Ivy Tech Institute">Ivy Tech Institute</option><option value="Metropolitan Arts Academy">Metropolitan Arts Academy</option></select></div> <button class="btn" onclick="saveSetup()">Continue →</button>;
}
function saveSetup() {
gameState.name = document.getElementById("input-name").value || "Student";
gameState.college = document.getElementById("select-college").value;
if(gameState.college === "Ivy Tech Institute") { gameState.gpa = 3.8; gameState.money = 300; }
else if(gameState.college === "Metropolitan Arts Academy") { gameState.money = 700; }
updateUI(); renderJob();
}
function renderJob() {
document.getElementById("game-img").src = images.jobSelect;
document.getElementById("scenario-counter").innerText = "Setup: Job";
document.getElementById("story-box").innerText = Pick a part-time job to manage your lifestyle between choices:;
document.getElementById("interactive-container").innerHTML =  <button class="btn" onclick="saveJob('Library Assistant')">📚 Library Assistant (Low Stress)</button><br><br> <button class="btn" onclick="saveJob('Cafe Barista')">☕ Cafe Barista (Medium Pay)</button><br><br> <button class="btn" onclick="saveJob('Night Coder')">💻 Freelance Night Coder (High Pay/Stress)</button>;
}
function saveJob(job) { gameState.job = job; updateUI(); runScenarios(); }
function runScenarios() {
let index = gameState.currentScenarioIndex;
if (index >= 30 || index >= gameState.selectedScenarios.length) { renderEnd(); return; }
document.getElementById("scenario-counter").innerText = Scenario ${index + 1} of 30;
let currentStep = gameState.selectedScenarios[index];
let html = "";
if (currentStep.type === "base") {
let sc = currentStep.data;
gameState.currentBaseChoices = sc.choices;
document.getElementById("story-box").innerText = sc.text;
document.getElementById("game-img").src = sc.image;
sc.choices.forEach((c, i) => { html += <button class="btn" onclick="chooseBase(${i})">${c.text}</button><br><br>; });
} else {
let followKey = gameState.lastChoiceId || "exam_sprint";
let sc = followUpScenarios[followKey] || followUpScenarios["exam_sprint"];
document.getElementById("story-box").innerText = [Consequence] ${sc.text};
document.getElementById("game-img").src = sc.image;
sc.choices.forEach((c, i) => { html += <button class="btn" onclick="chooseFollow(${i}, '${followKey}')">${c.text}</button><br><br>; });
}
document.getElementById("interactive-container").innerHTML = html;
}
function chooseBase(i) {
let choice = gameState.currentBaseChoices[i];
applyStats(choice);
gameState.lastChoiceId = choice.nextScenarioId;
document.getElementById("story-box").innerText = choice.outcome;
document.getElementById("interactive-container").innerHTML = <button class="btn" onclick="next()">See Immediate Consequence →</button>;
}
function chooseFollow(i, key) {
let choice = followUpScenarios[key].choices[i];
applyStats(choice);
document.getElementById("story-box").innerText = choice.outcome;
document.getElementById("interactive-container").innerHTML = <button class="btn" onclick="next()">Advance to Next Day →</button>;
}
function applyStats(c) {
gameState.money += c.money;
gameState.gpa = Math.min(4.0, Math.max(0.0, parseFloat((gameState.gpa + c.gpa).toFixed(2))));
gameState.mental = Math.min(100, Math.max(0, gameState.mental + c.mental));
gameState.socialScore = Math.min(100, Math.max(0, gameState.socialScore + c.social));
updateUI();
}
function next() { gameState.currentScenarioIndex++; runScenarios(); }
function renderEnd() {
document.getElementById("scenario-counter").innerText = "Graduation";
document.getElementById("game-img").src = images.setup;
let standing = "Average Academic Mark";
if(gameState.gpa >= 3.7) standing = "Summa Cum Laude Graduate 🌟";
else if(gameState.gpa < 2.0) standing = "Dropped Out of College ❌";
document.getElementById("story-box").innerText = You finished your 30-scenario college cycle at ${gameState.college}!\n\nFinal Academic Achievement: ${standing};
document.getElementById("interactive-container").innerHTML = <button class="btn" onclick="location.reload()">Play Again 🔄</button>;
}
function updateUI() {
document.getElementById("stat-name").innerText = gameState.name;
document.getElementById("stat-college").innerText = gameState.college;
document.getElementById("stat-job").innerText = gameState.job || "None";
document.getElementById("stat-money").innerText = $${gameState.money};
document.getElementById("stat-gpa").innerText = gameState.gpa.toFixed(2);
document.getElementById("stat-mental").innerText = ${gameState.mental}%;
let rep = "Neutral";
if(gameState.socialScore > 70) rep = "Campus Idol 🔥";
else if(gameState.socialScore < 30) rep = "Social Outcast 🤫";
document.getElementById("stat-social").innerText = rep;
}
window.onload = initGame;
